<div class="confirm-section">
  <div class="container">
    <div class="confirm-card">
      <div class="confirm-icon" style="color: var(--color-error)">
        <i class="fas fa-times-circle"></i>
      </div>
      <h1 class="confirm-title">Payment Failed</h1>
      <p class="confirm-desc">Your payment was not successful. Please try again or choose a different payment method.</p>
      <div class="confirm-actions">
        <a href="/checkout" class="btn btn-primary">Try Again</a>
        <a href="/contact" class="btn btn-outline">Contact Support</a>
      </div>
    </div>
  </div>
</div>
