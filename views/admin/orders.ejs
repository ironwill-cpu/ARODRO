<div class="admin-page">
  <div class="admin-header">
    <h1>Orders</h1>
    <div class="admin-tabs">
      <a href="/admin/orders" class="tab-link <%= !currentStatus ? 'active' : '' %>">All</a>
      <a href="/admin/orders?status=pending" class="tab-link <%= currentStatus === 'pending' ? 'active' : '' %>">Pending</a>
      <a href="/admin/orders?status=processing" class="tab-link <%= currentStatus === 'processing' ? 'active' : '' %>">Processing</a>
      <a href="/admin/orders?status=shipped" class="tab-link <%= currentStatus === 'shipped' ? 'active' : '' %>">Shipped</a>
      <a href="/admin/orders?status=delivered" class="tab-link <%= currentStatus === 'delivered' ? 'active' : '' %>">Delivered</a>
      <a href="/admin/orders?status=cancelled" class="tab-link <%= currentStatus === 'cancelled' ? 'active' : '' %>">Cancelled</a>
    </div>
  </div>

  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Customer</th>
          <th>Phone</th>
          <th>Total</th>
          <th>Payment</th>
          <th>Status</th>
          <th>Date</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (orders.length > 0) { %>
          <% orders.forEach(order => { %>
            <tr>
              <td><a href="/admin/orders/<%= order.order_id %>"><%= order.order_id %></a></td>
              <td><%= order.customer_name %></td>
              <td><%= order.customer_phone %></td>
              <td>৳<%= order.total.toLocaleString() %></td>
              <td><span class="status-badge"><%= order.payment_method.toUpperCase() %></span></td>
              <td>
                <span class="status-badge status-<%= order.status %>"><%= order.status %></span>
              </td>
              <td><%= new Date(order.created_at).toLocaleDateString() %></td>
              <td style="white-space:nowrap">
                <a href="/admin/orders/<%= order.order_id %>" class="btn btn-sm btn-outline">View</a>
                <button class="btn btn-sm btn-outline" onclick="quickStatus('<%= order.order_id %>')" style="margin-left:4px;">⚡ Status</button>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="8" class="admin-empty">No orders found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
function quickStatus(orderId) {
  const statuses = ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];
  const current = prompt('Change status for ' + orderId + ':\n1. Pending\n2. Processing\n3. Shipped\n4. Delivered\n5. Cancelled\n\nEnter number (1-5):');
  if (!current) return;
  const idx = parseInt(current) - 1;
  if (isNaN(idx) || idx < 0 || idx >= statuses.length) { alert('Invalid choice!'); return; }
  const status = statuses[idx];
  fetch('/admin/orders/' + orderId + '/status', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'status=' + status
  }).then(r => {
    if (r.redirected) location.reload();
    else location.reload();
  });
}
</script>
