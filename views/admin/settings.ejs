<!-- Admin Settings Page -->
<div class="admin-page">
  <div class="admin-header">
    <h1><i class="fas fa-paint-brush"></i> Website Customization</h1>
    <span class="admin-badge">Full Control</span>
  </div>
  
  <% if (message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>
  
  <form method="POST" action="/admin/settings/update">
  <% 
  const groupLabels = {
    'general': '🏪 General',
    'hero': '🎯 Hero / Banner',
    'colors': '🎨 Colors & Theme',
    'footer': '📄 Footer',
    'social': '🌐 Social Media',
    'about': '📖 About Page',
    'announcement': '📢 Announcement Bar'
  };
  
  const groupOrder = ['general', 'hero', 'announcement', 'colors', 'footer', 'social', 'about'];
  %>
  
  <% groupOrder.forEach(groupName => { %>
    <% const items = groups[groupName]; if (!items || items.length === 0) return; %>
    <div class="admin-card settings-card" style="margin-bottom:20px;">
      <h3 style="margin-bottom:16px;font-size:16px;color:var(--color-text);">
        <%= groupLabels[groupName] || groupName %>
      </h3>
      <div class="settings-grid">
        <% items.forEach(setting => { %>
          <div class="setting-field" data-type="<%= setting.type %>">
            <label class="setting-label">
              <%= setting.key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %>
            </label>
            
            <% if (setting.type === 'color') { %>
              <div class="color-picker-wrap">
                <input type="color" class="color-picker" 
                  value="<%= setting.value || '#000000' %>"
                  onchange="document.getElementById('color_<%= setting.key %>').value=this.value;
                           document.getElementById('preview_<%= setting.key %>').style.background=this.value;">
                <input type="text" name="setting_<%= setting.key %>" 
                  id="color_<%= setting.key %>" value="<%= setting.value %>" 
                  class="form-input color-input">
                <span class="color-swatch" id="preview_<%= setting.key %>" 
                  style="background:<%= setting.value %>;width:32px;height:32px;border-radius:50%;border:2px solid #ddd;display:inline-block;vertical-align:middle;flex-shrink:0;"></span>
              </div>
              
            <% } else if (setting.type === 'image') { %>
              <div class="image-upload-wrap">
                <div class="image-preview" id="preview_<%= setting.key %>">
                  <% if (setting.value) { %>
                    <img src="<%= setting.value %>" style="max-width:120px;max-height:60px;object-fit:contain;">
                  <% } else { %>
                    <div class="no-image">No image</div>
                  <% } %>
                </div>
                <div class="image-upload-actions">
                  <button type="button" class="btn btn-sm btn-outline" onclick="uploadSettingImage('<%= setting.key %>')">
                    <i class="fas fa-upload"></i> Upload
                  </button>
                  <% if (setting.value) { %>
                    <button type="button" class="btn btn-sm btn-outline" onclick="removeSettingImage('<%= setting.key %>')" style="color:#c62828;">
                      <i class="fas fa-times"></i> Remove
                    </button>
                  <% } %>
                </div>
                <input type="hidden" name="setting_<%= setting.key %>" id="input_<%= setting.key %>" value="<%= setting.value || '' %>">
                <input type="file" id="file_<%= setting.key %>" accept="image/*" style="display:none" onchange="uploadFile('<%= setting.key %>')">
              </div>
              
            <% } else if (setting.type === 'boolean') { %>
              <label class="toggle-switch">
                <input type="checkbox" name="setting_<%= setting.key %>" value="true" 
                  <%= setting.value === 'true' ? 'checked' : '' %>
                  onchange="this.value=this.checked?'true':'false'">
                <span class="toggle-slider"></span>
              </label>
              <input type="hidden" name="setting_<%= setting.key %>" value="<%= setting.value %>" 
                id="hidden_<%= setting.key %>">
              
            <% } else if (setting.type === 'textarea') { %>
              <textarea name="setting_<%= setting.key %>" class="form-input" rows="3"><%= setting.value %></textarea>
              
            <% } else { %>
              <input type="text" name="setting_<%= setting.key %>" value="<%= setting.value || '' %>" class="form-input">
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  <% }); %>
  
  <div class="form-actions" style="display:flex;gap:12px;margin-top:16px;">
    <button type="submit" class="btn btn-primary btn-lg">
      <i class="fas fa-save"></i> Save All Settings
    </button>
    <button type="button" class="btn btn-outline btn-lg" onclick="location.reload()">
      <i class="fas fa-sync"></i> Reset Form
    </button>
  </div>
  </form>
</div>

<style>
.settings-card { padding: 24px; }
.settings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
.setting-field { display: flex; flex-direction: column; gap: 6px; }
.setting-label { font-size: 12px; font-weight: 500; color: var(--color-text-light); text-transform: uppercase; letter-spacing: 0.5px; }
.color-picker-wrap { display: flex; align-items: center; gap: 8px; }
.color-picker { width: 40px; height: 40px; border: none; border-radius: 8px; cursor: pointer; padding: 0; }
.color-input { width: 120px !important; flex: 1; font-family: monospace; }
.image-upload-wrap { display: flex; align-items: center; gap: 12px; }
.image-preview { width: 120px; height: 60px; border: 1px dashed #ddd; border-radius: 8px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.no-image { color: #999; font-size: 12px; }
.image-upload-actions { display: flex; flex-direction: column; gap: 4px; }
.toggle-switch { position: relative; display: inline-block; width: 44px; height: 24px; }
.toggle-switch input { opacity: 0; width: 0; height: 0; }
.toggle-slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: #ccc; border-radius: 24px; transition: .3s; }
.toggle-slider:before { content: ""; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: .3s; }
.toggle-switch input:checked + .toggle-slider { background: var(--color-primary); }
.toggle-switch input:checked + .toggle-slider:before { transform: translateX(20px); }
</style>

<script>
function uploadSettingImage(key) {
  document.getElementById('file_' + key).click();
}

function uploadFile(key) {
  const file = document.getElementById('file_' + key).files[0];
  if (!file) return;
  
  const formData = new FormData();
  formData.append('image', file);
  formData.append('setting_key', key);
  
  fetch('/admin/settings/upload-image', {
    method: 'POST',
    body: formData
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      document.getElementById('input_' + key).value = data.url;
      const preview = document.getElementById('preview_' + key);
      preview.innerHTML = '<img src="' + data.url + '?t=' + Date.now() + '" style="max-width:120px;max-height:60px;object-fit:contain;">';
      showToast('Image uploaded! ✅');
    } else {
      showToast(data.message || 'Upload failed', '❌');
    }
  })
  .catch(() => showToast('Upload error', '❌'));
}

function removeSettingImage(key) {
  fetch('/admin/settings/update', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ key, value: '' })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      document.getElementById('input_' + key).value = '';
      document.getElementById('preview_' + key).innerHTML = '<div class="no-image">No image</div>';
      showToast('Image removed');
    }
  });
}

// Handle booleans properly
document.querySelectorAll('.toggle-switch input').forEach(toggle => {
  toggle.addEventListener('change', function() {
    document.getElementById('hidden_' + this.name.replace('setting_', '')).value = this.checked ? 'true' : 'false';
  });
});
</script>
