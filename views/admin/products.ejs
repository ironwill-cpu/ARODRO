<div class="page-header">
  <div>
    <h1>Products</h1>
    <p><%= products.length %> total products</p>
  </div>
  <a href="/admin/products/new" class="btn btn-primary"><i class="fas fa-plus"></i> Add Product</a>
</div>

<div class="section-card">
  <% if (products.length > 0) { %>
    <div class="table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Featured</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(product => { %>
            <tr>
              <td>
                <% if (product.image) { %>
                  <img src="<%= product.image %>" alt="<%= product.name %>" class="product-thumb">
                <% } else { %>
                  <div class="product-thumb" style="background:#f0e6df;display:flex;align-items:center;justify-content:center;color:#ccc;"><i class="fas fa-gem"></i></div>
                <% } %>
              </td>
              <td><strong><%= product.name %></strong></td>
              <td><%= product.category_name || '—' %></td>
              <td>৳<%= Number(product.price).toLocaleString() %></td>
              <td><%= product.stock %></td>
              <td>
                <button class="featured-toggle <%= product.featured ? 'active' : '' %>" 
                  data-id="<%= product.id %>" 
                  title="<%= product.featured ? 'Remove from Best Sellers' : 'Add to Best Sellers' %>"
                  onclick="toggleFeatured(<%= product.id %>, this)">
                  <i class="fas fa-star"></i>
                </button>
              </td>
              <td style="white-space:nowrap">
                <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></a>
                <form action="/admin/products/delete/<%= product.id %>" method="POST" style="display:inline" onsubmit="return confirm('Delete this product?')">
                  <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-box-open"></i>
      <h3>No products yet</h3>
      <p>Start by adding your first product.</p>
      <a href="/admin/products/new" class="btn btn-primary" style="margin-top:12px"><i class="fas fa-plus"></i> Add Product</a>
    </div>
  <% } %>
</div>

<style>
.featured-toggle {
  background: none;
  border: none;
  font-size: 20px;
  cursor: pointer;
  color: #ccc;
  transition: all 0.2s;
  padding: 4px 8px;
}
.featured-toggle:hover { color: #c4975a; transform: scale(1.15); }
.featured-toggle.active { color: #c4975a; }
.featured-toggle.active:hover { color: #e53935; }
</style>

<script>
function toggleFeatured(id, btn) {
  fetch('/admin/products/toggle-featured/' + id, { method: 'POST' })
    .then(r => r.json())
    .then(res => {
      if (res.success) {
        btn.classList.toggle('active', res.featured);
        btn.title = res.featured ? 'Remove from Best Sellers' : 'Add to Best Sellers';
        showToast(res.featured ? '⭐ Added to Best Sellers!' : 'Removed from Best Sellers');
      } else {
        alert('Error: ' + (res.message || 'Unknown'));
      }
    })
    .catch(e => alert('Error: ' + e.message));
}
</script>
