<div class="admin-page">
  <div class="admin-header">
    <h1>Products</h1>
    <a href="/admin/products/new" class="btn btn-primary"><i class="fas fa-plus"></i> Add Product</a>
  </div>

  <div class="admin-table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Category</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Featured</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (products.length > 0) { %>
          <% products.forEach(product => { %>
            <tr>
              <td><strong><%= product.name %></strong></td>
              <td><%= product.category_name || '—' %></td>
              <td>৳<%= product.price.toLocaleString() %></td>
              <td><%= product.stock %></td>
              <td><%= product.featured ? '⭐' : '—' %></td>
              <td><span class="status-badge status-<%= product.active ? 'active' : 'inactive' %>"><%= product.active ? 'Active' : 'Inactive' %></span></td>
              <td class="actions-cell">
                <a href="/admin/products/edit/<%= product.id %>" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></a>
                <form action="/admin/products/delete/<%= product.id %>" method="POST" style="display:inline" onsubmit="return confirm('Delete this product?')">
                  <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr><td colspan="7" class="admin-empty">No products yet. <a href="/admin/products/new">Add your first product</a></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
