<!-- Hero Section (Auto-Slider) -->
<%
  // Compute dynamic hero styles from admin settings
  const heroAlign = (site.hero_align || 'left');
  const heroPos = (site.hero_position || 'middle');
  const heroSize = (site.hero_size || 'medium');
  const overlay = parseInt(site.hero_overlay || 25, 10);
  const tSize = (site.hero_title_size || 'large');

  const heroContentStyle = heroAlign === 'center' ? 'text-align:center;align-items:center;' :
    (heroAlign === 'right' ? 'text-align:right;align-items:flex-end;margin-left:auto;' : 'text-align:left;align-items:flex-start;');
  const heroSlidePad = heroSize === 'small' ? 'padding:24px 0 40px;' :
    (heroSize === 'large' ? 'padding:70px 0 100px;' : 'padding:40px 0 60px;');
  // Vertical position: top/middle/bottom of the hero area (flex column via align-items)
  const heroJustify = heroPos === 'top' ? 'align-items:flex-start;' :
    (heroPos === 'bottom' ? 'align-items:flex-end;' : 'align-items:center;');
  const heroTitleSize = tSize === 'small' ? 'font-size:48px;' :
    (tSize === 'medium' ? 'font-size:60px;' : 'font-size:72px;');
  const heroActionsStyle = heroAlign === 'center' ? 'justify-content:center;' :
    (heroAlign === 'right' ? 'justify-content:flex-end;' : '');
%>
<section class="hero" id="heroSlider">
  <div class="hero-slides">
    <!-- Slide 1: Main (admin settings) -->
    <div class="hero-slide active" style="<%= site.hero_image ? 'background:linear-gradient(rgba(30,6,6,' + (overlay/100) + '),rgba(30,6,6,' + (overlay/100) + ')),url(' + site.hero_image + ') center/cover no-repeat;' : '' %><%= heroSlidePad %><%= heroJustify %>">
      <div class="hero-bg"></div>
      <div class="container">
        <div class="hero-content" style="<%= heroContentStyle %>">
          <span class="hero-subtitle">✦ Welcome to <%= site.site_name || 'ARODRO' %> ✦</span>
          <h1 class="hero-title luxury-title" style="<%= heroTitleSize %>"><%= site.hero_title || 'Radiate Your<br>Natural Beauty' %></h1>
          <p class="hero-desc"><%= site.hero_subtitle || 'Discover premium cosmetics crafted for every skin tone. Luxury beauty, redefined.' %></p>
          <div class="hero-actions" style="<%= heroActionsStyle %>">
            <a href="<%= site.hero_button_link || '/category/skincare' %>" class="btn btn-primary"><i class="fas fa-shopping-bag"></i> <%= site.hero_button_text || 'Shop Now' %></a>
            <a href="#featured" class="btn btn-outline"><i class="fas fa-compass"></i> Explore Collection</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide 2: New Arrivals -->
    <div class="hero-slide" style="background:linear-gradient(135deg, #4a1010 0%, #6b1e1e 40%, #8a2e2e 70%, #a63737 100%);<%= heroSlidePad %><%= heroJustify %>">
      <div class="hero-bg"></div>
      <div class="container">
        <div class="hero-content" style="<%= heroContentStyle %>">
          <span class="hero-subtitle">✦ Fresh From The Lab ✦</span>
          <h1 class="hero-title luxury-title" style="<%= heroTitleSize %>">New Arrivals<br>Just Dropped</h1>
          <p class="hero-desc">Be the first to try our latest skincare and makeup innovations. Glow like never before.</p>
          <div class="hero-actions" style="<%= heroActionsStyle %>">
            <a href="/category/makeup" class="btn btn-primary"><i class="fas fa-shopping-bag"></i> Shop New</a>
            <a href="#featured" class="btn btn-outline"><i class="fas fa-star"></i> Best Sellers</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide 3: Sale -->
    <div class="hero-slide" style="background:linear-gradient(135deg, #3d0f0f 0%, #7a2626 45%, #c4975a 130%);<%= heroSlidePad %><%= heroJustify %>">
      <div class="hero-bg"></div>
      <div class="container">
        <div class="hero-content" style="<%= heroContentStyle %>">
          <span class="hero-subtitle">✦ Limited Time ✦</span>
          <h1 class="hero-title luxury-title" style="<%= heroTitleSize %>">Mega Beauty Sale<br>Up To 40% Off</h1>
          <p class="hero-desc">Treat yourself to luxury at an unbeatable price. Offer ends soon — don't miss out!</p>
          <div class="hero-actions" style="<%= heroActionsStyle %>">
            <a href="/category/skincare" class="btn btn-primary"><i class="fas fa-fire"></i> Grab The Deal</a>
            <a href="#featured" class="btn btn-outline"><i class="fas fa-arrow-right"></i> View All</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Slider Dots -->
  <div class="hero-dots">
    <button class="hero-dot active" data-slide="0" aria-label="Slide 1"></button>
    <button class="hero-dot" data-slide="1" aria-label="Slide 2"></button>
    <button class="hero-dot" data-slide="2" aria-label="Slide 3"></button>
  </div>
</section>


<!-- Categories Section -->
<section class="section categories-section">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Categories</span>
      <h2 class="section-title">Shop by Category</h2>
    </div>
    <div class="categories-grid">
      <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
        <% categories.forEach(cat => { %>
          <a href="/category/<%= cat.slug %>" class="category-card">
            <div class="category-icon">
              <% if (cat.slug === 'skincare') { %>
                <i class="fas fa-spa"></i>
              <% } else if (cat.slug === 'makeup') { %>
                <i class="fas fa-magic"></i>
              <% } else if (cat.slug === 'haircare') { %>
                <i class="fas fa-wind"></i>
              <% } else if (cat.slug === 'fragrance') { %>
                <i class="fas fa-flask"></i>
              <% } else { %>
                <i class="fas fa-leaf"></i>
              <% } %>
            </div>
            <h3 class="category-name"><%= cat.name %></h3>
            <p class="category-count"><%= cat.product_count || 0 %> Products</p>
            <span class="category-arrow"><i class="fas fa-arrow-right"></i></span>
          </a>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>

<!-- Featured Products -->
<section class="section featured-section" id="featured">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Featured</span>
      <h2 class="section-title">Best Sellers</h2>
    </div>
    <div class="products-grid">
      <% if (typeof featured !== 'undefined' && featured.length > 0) { %>
        <% featured.forEach(product => { %>
          <div class="product-card">
            <div class="product-image">
              <% if (product.image) { %>
                  <img src="<%= product.image %>" alt="<%= product.name %>">
                <% } else { %>
                  <div class="product-placeholder" style="background: linear-gradient(135deg, #e8c4c4, #d4a85333);">
                    <i class="fas fa-gem"></i>
                  </div>
                <% } %>
              <% if (product.compare_price) { %>
                <span class="product-badge sale">Sale</span>
              <% } %>
              <div class="product-actions">
                <button class="product-action-btn add-to-cart-btn" data-id="<%= product.id %>">
                  <i class="fas fa-shopping-bag"></i>
                </button>
                <a href="/products/<%= product.slug %>" class="product-action-btn">
                  <i class="fas fa-eye"></i>
                </a>
              </div>
            </div>
            <div class="product-info">
              <span class="product-category"><%= product.category_name || '' %></span>
              <h3 class="product-name"><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>
              <div class="product-pricing">
                <span class="product-price">৳<%= product.price.toLocaleString() %></span>
                <% if (product.compare_price) { %>
                  <span class="product-compare-price">৳<%= product.compare_price.toLocaleString() %></span>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</section>

<!-- Category Product Sections -->
<% if (typeof categoryProducts !== 'undefined') { %>
  <% Object.entries(categoryProducts).forEach(([slug, products]) => { %>
    <% if (products.length > 0) { %>
      <% const cat = categories.find(c => c.slug === slug); %>
      <section class="section category-products-section">
        <div class="container">
          <div class="section-header">
            <span class="section-label"><%= cat ? cat.name : '' %></span>
            <h2 class="section-title"><%= cat ? cat.name : '' %> Collection</h2>
            <a href="/category/<%= slug %>" class="section-link">View All <i class="fas fa-arrow-right"></i></a>
          </div>
          <div class="products-grid">
            <% products.forEach(product => { %>
              <div class="product-card">
                <div class="product-image">
                  <% if (product.image) { %>
                  <img src="<%= product.image %>" alt="<%= product.name %>">
                <% } else { %>
                  <div class="product-placeholder" style="background: linear-gradient(135deg, #e8c4c4, #d4a85333);">
                    <i class="fas fa-gem"></i>
                  </div>
                <% } %>
                  <% if (product.compare_price) { %>
                    <span class="product-badge sale">Sale</span>
                  <% } %>
                  <div class="product-actions">
                    <button class="product-action-btn add-to-cart-btn" data-id="<%= product.id %>">
                      <i class="fas fa-shopping-bag"></i>
                    </button>
                    <a href="/products/<%= product.slug %>" class="product-action-btn">
                      <i class="fas fa-eye"></i>
                    </a>
                  </div>
                </div>
                <div class="product-info">
                  <span class="product-category"><%= product.category_name || '' %></span>
                  <h3 class="product-name"><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>
                  <div class="product-pricing">
                    <span class="product-price">৳<%= product.price.toLocaleString() %></span>
                    <% if (product.compare_price) { %>
                      <span class="product-compare-price">৳<%= product.compare_price.toLocaleString() %></span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>
    <% } %>
  <% }); %>
<% } %>

<!-- Features Section -->
<section class="section features-section">
  <div class="container">
    <div class="features-grid">
      <div class="feature-card">
        <i class="fas fa-truck feature-icon"></i>
        <h3 class="feature-title">Free Shipping</h3>
        <p class="feature-desc">On orders over ৳1,500</p>
      </div>
      <div class="feature-card">
        <i class="fas fa-shield-alt feature-icon"></i>
        <h3 class="feature-title">100% Authentic</h3>
        <p class="feature-desc">Genuine products guaranteed</p>
      </div>
      <div class="feature-card">
        <i class="fas fa-undo feature-icon"></i>
        <h3 class="feature-title">Easy Returns</h3>
        <p class="feature-desc">7-day return policy</p>
      </div>
      <div class="feature-card">
        <i class="fas fa-headset feature-icon"></i>
        <h3 class="feature-title">24/7 Support</h3>
        <p class="feature-desc">Dedicated customer care</p>
      </div>
    </div>
  </div>
</section>

<!-- Newsletter Section -->
<section class="section newsletter-section">
  <div class="container">
    <div class="newsletter-content">
      <h2 class="newsletter-title">Join the ARODRO Family</h2>
      <p class="newsletter-desc">Subscribe for exclusive offers, beauty tips, and new arrivals.</p>
      <form class="newsletter-form" id="newsletterForm">
        <input type="email" placeholder="Enter your email" class="newsletter-input" required>
        <button type="submit" class="btn btn-primary">Subscribe</button>
      </form>
    </div>
  </div>
</section>
