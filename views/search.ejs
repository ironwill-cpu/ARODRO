<!-- Search Results -->
<section class="page-header page-header-sm">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Home</a>
      <i class="fas fa-chevron-right"></i>
      <span>Search</span>
    </div>
    <h1 class="page-title">Search Results</h1>
    <p class="page-desc"><%= products.length %> result(s) for "<%= query %>"</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="search-form-container">
      <form action="/search" method="GET" class="search-form-lg">
        <input type="text" name="q" value="<%= query %>" placeholder="Search products..." class="search-input-lg">
        <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i></button>
      </form>
    </div>

    <% if (products.length > 0) { %>
      <div class="products-grid">
        <% products.forEach(product => { %>
          <div class="product-card">
            <div class="product-image">
              <% if (product.image) { %>
                  <img src="<%= product.image %>" alt="<%= product.name %>">
                <% } else { %>
                  <div class="product-placeholder" style="background: linear-gradient(135deg, #e8c4c4, #d4a85333);">
                    <i class="fas fa-gem"></i>
                  </div>
                <% } %>
              <% if (product.compare_price) { %>
                <span class="product-badge sale">Sale</span>
              <% } %>
              <div class="product-actions">
                <button class="product-action-btn add-to-cart-btn" data-id="<%= product.id %>">
                  <i class="fas fa-shopping-bag"></i>
                </button>
                <a href="/products/<%= product.slug %>" class="product-action-btn">
                  <i class="fas fa-eye"></i>
                </a>
              </div>
            </div>
            <div class="product-info">
              <span class="product-category"><%= product.category_name %></span>
              <h3 class="product-name"><a href="/products/<%= product.slug %>"><%= product.name %></a></h3>
              <div class="product-pricing">
                <span class="product-price">৳<%= product.price.toLocaleString() %></span>
                <% if (product.compare_price) { %>
                  <span class="product-compare-price">৳<%= product.compare_price.toLocaleString() %></span>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else if (query.trim()) { %>
      <div class="empty-state">
        <i class="fas fa-search"></i>
        <h3>No products found</h3>
        <p>We couldn't find any products matching "<%= query %>". Try different keywords.</p>
        <a href="/" class="btn btn-primary">Browse All Products</a>
      </div>
    <% } %>
  </div>
</section>
